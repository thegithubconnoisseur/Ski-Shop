# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://skiitrope.com (needed in production)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Supabase database ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Leave empty to use the local SQLite file instead. When your Supabase project
# is ready, use the "Session pooler" URL and append ?sslmode=require, e.g.:
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Leave 0 when connecting through the Supabase pooler
DB_CONN_MAX_AGE=0

# --- Google OAuth (Google Cloud Console) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mailgun -------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.example.com
MAILGUN_API_URL=https://api.mailgun.net/v3
DEFAULT_FROM_EMAIL=Skiitrope <orders@mg.example.com>
SERVER_EMAIL=Skiitrope <alerts@mg.example.com>
ORDER_NOTIFICATION_EMAIL=owner@example.com

# --- Stripe (USD, international cards) -----------------------------------
# Leave empty to keep card payments switched off. Test keys look like
# pk_test_... / sk_test_... / whsec_... (Stripe dashboard -> Developers).
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Shop rules ----------------------------------------------------------
FREE_SHIPPING_THRESHOLD=300
FLAT_SHIPPING_RATE=15
